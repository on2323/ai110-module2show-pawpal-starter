classDiagram
    class Task {
        +str description
        +str time
        +str frequency
        +bool completed
        +mark_complete()
    }
    class Pet {
        +str name
        +str species
        +List~Task~ tasks
        +add_task(Task task)
    }
    class Owner {
        +str name
        +List~Pet~ pets
        +add_pet(Pet pet)
        +get_all_tasks()
    }
    class Scheduler {
        +Owner owner
        +sort_by_time()
        +filter_tasks()
    }
    Owner "1" *-- "0..*" Pet : manages
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : reads all tasks
